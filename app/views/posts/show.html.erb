<% if @post.image.attached? %>
  <%= image_tag @post.image, width: 600 %>
<% end %>
<br>
<%= @post.description %>
<div class="link">
  <% if @post.user == current_user %>
    <%= link_to "Edit", edit_post_path(@post) %>
    <%= button_to "Destroy", post_path(@post), method: :delete,
                  form: { data: { turbo_confirm: "Are you sure?" } } %>
  <% end %>
</div> 
