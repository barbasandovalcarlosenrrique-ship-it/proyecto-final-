<% @posts.each do |x| %>
  <div>
    <% if x.image.attached? %>
      <%= image_tag x.image, width: 300 %>
    <% end %>
    <br>
    <%= x.description %>
    <div class="link">
      <%= link_to "Show", post_path(x) %>
      <% if x.user == current_user %>
        <%= link_to "Edit", edit_post_path(x) %>
        <%= button_to "Destroy", post_path(x), method: :delete,
                      form: { data: { turbo_confirm: "Are you sure?" } } %>
      <% end %>
    </div>
  </div>
<% end %>
