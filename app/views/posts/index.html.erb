<% @post.each do |x| %>
  <div>
    <%= image_tag x.image.variant(resize_to_limit: [300, 300]) if x.image.attached? %>
    <br>
    <%= x.description %>
    <div class="link">
      <%= link_to "Destroy", x, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      <%= link_to "Edit", edit_post_path(x) %>
      <%= link_to "Show", x %>
    </div>
  </div>
<% end %>
